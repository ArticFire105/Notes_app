.env
.venv/
# Keep real notes and evaluation data private, but commit the format example.
data/*
!data/eval/
data/eval/*
!data/eval/questions.example.json
__pycache__/
*.pdf
.ipynb_checkpoints/
.pytest_cache/
*.py[cod]

# Downloaded models and tooling are reproducible, not project source.
.cache/
.huggingface/
models/
model_cache/
sentence_transformers/
.tools/

# The Next.js app is rebuilt from package-lock.json and source.
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo
web/.env*
!web/.env.example
