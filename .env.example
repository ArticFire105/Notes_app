# Set in the shell or host environment before startup; defaults to production.
# This switch is read directly from the process environment, not from .env.
APP_ENV=production
# Phase 6 frontend: set this in its shell; Streamlit does not load .env.
API_BASE_URL=http://127.0.0.1:8000
# Next.js browser client: set in its shell before npm run dev/build (public URL only).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Supabase dashboard: Connect > Session pooler; replace the password yourself.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Supabase dashboard: Project Settings > API > Project URL.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase dashboard: Project Settings > API Keys > anon key.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Supabase dashboard: Project Settings > API Keys > service_role key (backend only).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Google AI Studio: API Keys > Create API key.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Hugging Face: Settings > Access Tokens; accept the model's access terms too.
HF_TOKEN=YOUR_HF_READ_TOKEN
# Use Gemini embeddings for document and question search.
EMBEDDING_PROVIDER=gemini
# Gemini embedding model; re-embed existing chunks before switching.
EMBEDDING_MODEL=gemini-embedding-2
# Project plan: must match vector(768) in the database migration.
EMBEDDING_DIM=768
# Project plan: LangChain provider:model identifier for later answer generation.
CHAT_MODEL=google_genai:gemini-3.5-flash-lite
# Phase 2: maximum tokens generated per answer; adjust locally if needed.
MAX_OUTPUT_TOKENS=800
# Phase 4: only this college email domain can use the API.
ALLOWED_EMAIL_DOMAIN=dxb.manipal.edu
# Phase 5: server-key questions per student per Dubai calendar day.
QUESTIONS_PER_DAY=5
# Phase 5: approximate retrieved-context limit (one token is estimated as four characters).
MAX_CONTEXT_TOKENS=4000
# Phase 5: total server-key requests per Dubai day; choose your own cap.
GLOBAL_DAILY_CAP=100
# Phase 5: optional estimated daily USD budget; empty disables it.
GLOBAL_DAILY_BUDGET_USD=
# Copy from the current Gemini API pricing page for CHAT_MODEL; 0 means unknown.
PRICE_INPUT_PER_1M_USD=0
# Copy from the current Gemini API pricing page for CHAT_MODEL; 0 means unknown.
PRICE_OUTPUT_PER_1M_USD=0

# Comma-separated exact browser origins; use your HTTPS frontend origin in production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini model used for handwritten document transcription.
OCR_MODEL=gemini-3.5-flash-lite
